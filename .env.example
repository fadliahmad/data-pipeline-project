# Source: Neon, direct host (without -pooler)
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
SOURCE_SCHEMA=postgresql_media_data

# BigQuery. All three datasets can point at the same dataset:
# bronze keeps source table names; the rest are prefixed std_, scd_, cdc_, dim_, fct_, agg_, mrt_.
BQ_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=asia-southeast2
BQ_DATASET_BRONZE=your_dataset
BQ_DATASET_SILVER=your_dataset
BQ_DATASET_GOLD=your_dataset

# Airflow (generate your own values)
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=
